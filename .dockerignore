# Lista de inclusion: todo queda fuera salvo los insumos del build.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!restricciones-python.txt
!fonts.conf
!src/
!src/videocodigo/
!src/videocodigo/*.py
!src/videocodigo/componentes/
!src/videocodigo/componentes/*.py
!src/videocodigo_web/
!src/videocodigo_web/*.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/favicon.svg
!frontend/public/favicon-32.png
!frontend/public/apple-touch-icon.png
!frontend/public/grano.png
!frontend/public/marca/
!frontend/public/marca/*.svg
!frontend/public/voz/
!frontend/public/voz/*.html
!frontend/public/voz/*.css
!frontend/public/voz/*.js
!frontend/public/instalador/
!frontend/public/instalador/Instalar-FilmCode.cmd
!frontend/public/instalador/Instalar-FilmCode.ps1
!frontend/public/instalador/Operaciones-FilmCode.ps1
!frontend/public/instalador/README.md
!frontend/public/instalador/instalador-windows.zip
# Exclusiones finales que prevalecen incluso dentro de los directorios permitidos.
**/.env
**/.env.*
**/configuracion.local
**/__pycache__/**
**/*.pyc
**/*.log
**/node_modules/**
**/dist/**
**/*.mp4
**/*.webm
**/*.mov
**/*.wav
**/*.mp3
**/*.m4a
**/*.ogg
